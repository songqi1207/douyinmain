# Browser-facing URL that Coze/Mihe can use to fetch uploaded assets.
PUBLIC_BASE_URL=https://your-domain.example.com

# Stage 1: template = topic -> downloadable Coze workflow JSON.
# After every workflow is tested and published, switch to published + coze.
WORKFLOW_BUILD_MODE=template
WORKFLOW_PROVIDER_MODE=demo
WORKFLOW_QUEUE_MODE=inline
WORKFLOW_LOG_LEVEL=INFO

COZE_API_TOKEN=
# Coze requests bypass Windows/system proxies by default.
COZE_USE_ENV_PROXY=false
COZE_CONNECT_TIMEOUT_SECONDS=45
COZE_CONNECT_ATTEMPTS=3
COZE_INCOMPLETE_DRAFT_ATTEMPTS=2
COZE_WORKFLOW_TIMEOUT_SECONDS=900
COZE_WORKFLOW_G247=
COZE_WORKFLOW_G218=
COZE_WORKFLOW_G159=
COZE_WORKFLOW_G259=
COZE_WORKFLOW_G258=
COZE_WORKFLOW_G168=
COZE_WORKFLOW_G45=
COZE_WORKFLOW_G263=
COZE_WORKFLOW_G129=
COZE_WORKFLOW_G222=
COZE_WORKFLOW_OWN01=
COZE_WORKFLOW_OWN02=
COZE_WORKFLOW_OWN03=
# Backward-compatible alias for COZE_WORKFLOW_OWN03.
COZE_WORKFLOW_GOD=

# One-click defaults; secrets remain server-side and are never sent to browsers.
BOOK_ACCOUNT_NAME="  "
BOOK_DEFAULT_AUTHOR=佚名
BOOK_DEFAULT_IMAGE_COUNT=2
BOOK_DEFAULT_VOICE_ID=7620288417930297386
# Optional extra workflow voices. Values must be real Coze voice IDs; valid
# entries are appended to the built-in concrete-name selector.
COZE_VOICE_OPTIONS_JSON=[]
CIGARETTE_LEFT_TEXT=未成年人禁止吸烟
CIGARETTE_LEFT_TOP_TEXT=吸烟有害身体健康
MIHE_KEY=
SUTUI_API_KEY=
VOLCENGINE_API_KEY=
FEISHU_ASSET_URL=
WORKFLOW_RENDER_API_URL=
WORKFLOW_RENDER_API_TOKEN=
DEVICE_RENDERING_ENABLED=true
DEVICE_PAIRING_TTL_SECONDS=600
DEVICE_ONLINE_TTL_SECONDS=90
DEVICE_RENDER_LEASE_SECONDS=3600
DEVICE_RENDER_MAX_UPLOAD_BYTES=2147483648
WORKFLOW_RENDER_TIMEOUT_SECONDS=2400
WORKFLOW_RENDER_DOWNLOAD_TIMEOUT_SECONDS=1800
WORKFLOW_RENDER_MAX_VIDEO_BYTES=4294967296

# Optional post-export delivery: compress JianYing MP4 files and publish them
# through the protected upload endpoint of the workflow-media Worker.
R2_EXPORT_ENABLED=0
R2_EXPORT_UPLOAD_URL=https://media.songqi.online/exports
R2_EXPORT_PUBLIC_BASE_URL=https://media.songqi.online/exports
R2_EXPORT_UPLOAD_TOKEN=
R2_EXPORT_VIDEO_CRF=20
R2_EXPORT_VIDEO_PRESET=slow
R2_EXPORT_AUDIO_BITRATE=128k
# Browser playback uses a separate high-quality 1080p preview. Downloads keep
# the original JianYing 1080p/60fps file without re-encoding.
R2_EXPORT_PREVIEW_WIDTH=1920
R2_EXPORT_PREVIEW_HEIGHT=1080
R2_EXPORT_PREVIEW_FPS=30
R2_EXPORT_PREVIEW_CRF=20
R2_EXPORT_PREVIEW_MAXRATE=5000k
R2_EXPORT_PREVIEW_BUFSIZE=10000k
R2_EXPORT_PREVIEW_AUDIO_BITRATE=128k
R2_EXPORT_COMPRESSION_TIMEOUT_SECONDS=3600
R2_EXPORT_UPLOAD_TIMEOUT_SECONDS=900
WORKFLOW_MAX_DRAFT_KEY_BYTES=5242880

# Volcengine VOD server-side editing. Keep the real AK/SK in .env only.
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
VOD_SPACE_NAME=douyin-render-dev
VOD_REGION=cn-north-1

# Optional internal accounting fields (never shown as provider secrets).
WORKFLOW_COST_CENTS_G247=100
WORKFLOW_PRICE_CENTS_G247=150

# Production Docker Compose uses these automatically.
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=*

# Windows 本地生成剪映草稿时必须指向剪映“全局设置 → 草稿位置”显示的目录。
# 未配置且检测不到默认目录时，程序只会写到项目的 temp/jianying_drafts 兜底目录。
JIANYING_DRAFT_ROOT=

# Member accounts use an HttpOnly same-site session cookie. Enable secure cookies on HTTPS production.
SITE_COOKIE_SECURE=false
SITE_SESSION_TTL_SECONDS=2592000
# Optional separate SQLite file; defaults to WORKFLOW_DATA_DIR/site.sqlite3.
SITE_DB_PATH=

# Approval-only registration. These credentials bootstrap the admin reviewer account.
# Use a long unique password in .env; never commit the real value.
SITE_ADMIN_EMAIL=admin@example.com
SITE_ADMIN_PASSWORD=replace-with-a-long-random-password

# Ordinary-user point and storage defaults. 5 GiB = 5368709120 bytes.
DEFAULT_GENERATION_CREDITS=10
# One legacy "generation" becomes 4 points for historical ledger conversion.
LEGACY_CREDIT_POINT_RATE=4
# Newly approved ordinary users start with 1000 platform points.
DEFAULT_POINTS_BALANCE=1000
DEFAULT_STORAGE_LIMIT_BYTES=5368709120
# The whole point denomination is 25x the original unit: 40 -> 1000.
POINT_DENOMINATION_SCALE=25
# Invite rewards are granted after the referred registration is approved.
DEFAULT_INVITER_REWARD_POINTS=250
DEFAULT_INVITEE_REWARD_POINTS=250
# User price = (content-generation cost + MiHe cost) * multiplier.
BILLING_MARKUP_MULTIPLIER=2
DEFAULT_COZE_COST_POINTS=25
DEFAULT_MIHE_COST_POINTS=0
DEFAULT_LOCAL_MIHE_COST_POINTS=25

# Real approval email delivery. Approve is blocked when SMTP_HOST/SMTP_FROM are absent.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
# Optional admin inbox for immediate new-registration alerts.
REGISTRATION_NOTIFICATION_EMAIL=

# Optional cloud TTS adapter. Expected response: {audio_url}, {url}, or {data: {link, duration}}.
# Without TTS_API_URL the server lists and uses only actually installed Windows System.Speech voices.
# With a cloud adapter, provide its real public voice catalog as a JSON array; no fictional fallback voices are shown.
TTS_API_URL=
TTS_API_TOKEN=
TTS_VOICES_JSON=[]
